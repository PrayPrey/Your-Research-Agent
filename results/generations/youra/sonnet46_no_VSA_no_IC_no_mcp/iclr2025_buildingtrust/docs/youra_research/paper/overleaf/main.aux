\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Reliability diagrams for base vs.\ chat models on AdvGLUE MNLI. The chat model's overconfidence curve is shifted further from the diagonal than the base model's, consistent with the alignment tax.}}{22}{figure.11}\protected@file@percent }
