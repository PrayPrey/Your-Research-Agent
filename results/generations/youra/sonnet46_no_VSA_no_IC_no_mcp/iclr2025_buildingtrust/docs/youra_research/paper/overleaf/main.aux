\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Per-stratum ECE comparison. $\Delta $ECE $= +0.071$ for AdvGLUE MNLI is stable across strata, confirming it is not driven by a subset of label-mismatched examples.}}{22}{figure.9}\protected@file@percent }
\newlabel{fig:stratum_ece}{{9}{22}{Per-stratum ECE comparison. $\Delta $ECE $= +0.071$ for AdvGLUE MNLI is stable across strata, confirming it is not driven by a subset of label-mismatched examples}{figure.9}{}}
