delta_he = rlef_he - sft_he

def mk_arr(rate, n): return rng.binomial(1, max(rate, 0.001), size=n).astype(float)

# LCB proxy: simulate difficulty scaling (RLEF gains more on harder problems)
# Conservative: 1.2x on medium, 1.5x on hard (conservative relative to 1.5x gate)
