\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {Main Figure.} Estimated 13-gram contamination rate (x-axis) vs.\ accuracy differential (dedup-Pile minus Pile, y-axis) across 16 observations (4 benchmarks $\times $ 4 model sizes). Pearson $r = 0.632$, $p = 0.0086$. Higher contamination predicts more negative (corrective) accuracy differentials.}}{7}{figure.6}\protected@file@percent }
\newlabel{fig:main_scatter}{{6}{7}{\textbf {Main Figure.} Estimated 13-gram contamination rate (x-axis) vs.\ accuracy differential (dedup-Pile minus Pile, y-axis) across 16 observations (4 benchmarks $\times $ 4 model sizes). Pearson $r = 0.632$, $p = 0.0086$. Higher contamination predicts more negative (corrective) accuracy differentials}{figure.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Left: Bootstrap distribution ($B=1000$) for the Pearson $r=0.632$ estimate, with 95\% CI $[0.297, 0.858]$. Right: Per-benchmark accuracy differentials by model size, confirming directional consistency.}}{7}{figure.7}\protected@file@percent }
\newlabel{fig:bootstrap_and_bars}{{7}{7}{Left: Bootstrap distribution ($B=1000$) for the Pearson $r=0.632$ estimate, with 95\% CI $[0.297, 0.858]$. Right: Per-benchmark accuracy differentials by model size, confirming directional consistency}{figure.7}{}}
