\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Per-benchmark accuracy differential (dedup-Pile minus Pile) across four Pythia model sizes (160M--6.9B). MMLU shows a consistent negative differential across all sizes, while HellaSwag and ARC-Challenge show positive differentials --- the contamination-correction signature.}}{6}{figure.4}\protected@file@percent }
\newlabel{fig:differential_bar}{{4}{6}{Per-benchmark accuracy differential (dedup-Pile minus Pile) across four Pythia model sizes (160M--6.9B). MMLU shows a consistent negative differential across all sizes, while HellaSwag and ARC-Challenge show positive differentials --- the contamination-correction signature}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Left: Paired scatter plot showing per-benchmark accuracy (Pile vs.\ dedup-Pile) for each model size. Right: Correlation summary across estimators and model sizes. Both confirm the contamination-correction pattern.}}{6}{figure.5}\protected@file@percent }
\newlabel{fig:paired_scatter}{{5}{6}{Left: Paired scatter plot showing per-benchmark accuracy (Pile vs.\ dedup-Pile) for each model size. Right: Correlation summary across estimators and model sizes. Both confirm the contamination-correction pattern}{figure.5}{}}
