\bibcite{Biderman2023Pythia}{{1}{2023}{{Biderman et~al.}}{{Biderman, Schoelkopf, Anthony, Bradley, O'Brien, Hallahan, Khan, Purohit, Prashanth, Raff, Skowron, Sutawika, and Van Der~Wal}}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Min-$k$\% memorization analysis at Pythia-1B. Left: Comparison bar chart showing dedup-Pile consistently higher. Center: Sensitivity analysis across $k$ values --- direction reversal is robust. Right: Memorization differential heatmap across benchmarks. The dual-estimator disagreement (13-gram $r = +0.632$ vs.\ min-$k$\% $r = -0.713$) indicates these estimators capture different phenomena.}}{8}{figure.10}\protected@file@percent }
\newlabel{fig:mink_figures}{{10}{8}{Min-$k$\% memorization analysis at Pythia-1B. Left: Comparison bar chart showing dedup-Pile consistently higher. Center: Sensitivity analysis across $k$ values --- direction reversal is robust. Right: Memorization differential heatmap across benchmarks. The dual-estimator disagreement (13-gram $r = +0.632$ vs.\ min-$k$\% $r = -0.713$) indicates these estimators capture different phenomena}{figure.10}{}}
