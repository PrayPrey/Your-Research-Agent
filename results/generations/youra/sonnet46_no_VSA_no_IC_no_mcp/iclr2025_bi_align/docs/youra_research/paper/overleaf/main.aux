\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Bootstrap slope distribution for Coste et al.\ data ($N=10{,}000$ iterations, seed=42). The distribution is unimodal, approximately Gaussian, centered at $\beta \approx 0.143$, with bootstrap CI $[0.117, 0.177]$ strictly positive.}}{9}{figure.7}\protected@file@percent }
\newlabel{fig:bootstrap}{{7}{9}{Bootstrap slope distribution for Coste et al.\ data ($N=10{,}000$ iterations, seed=42). The distribution is unimodal, approximately Gaussian, centered at $\beta \approx 0.143$, with bootstrap CI $[0.117, 0.177]$ strictly positive}{figure.7}{}}
\@writefile{toc}{\contentsline {section}{\numberline {B}Gao et al.\ Dual-Axis Trajectory}{9}{appendix.B}\protected@file@percent }
\newlabel{app:gao}{{B}{9}{}{appendix.B}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Dual-axis plot for Gao et al.~\citep  {Gao2023Scaling} across 11 KL checkpoints (all available levels, including the KL$=0$ boundary point used for signal characterization in H-E1). Unlike Coste data, the gap is initially negative at low KL (gold preference rises faster than RM), crosses zero at $\sim $3.5 nats, then enters the positive regime. This non-monotone shape accounts for the lower $R^2 = 0.701$ in the Gao linear regression, which uses $n=10$ observations (the KL$=0$ boundary point excluded; see Section~\ref {subsec:replication}).}}{9}{figure.8}\protected@file@percent }
\newlabel{fig:gao_dual}{{8}{9}{Dual-axis plot for Gao et al.~\cite {Gao2023Scaling} across 11 KL checkpoints (all available levels, including the KL$=0$ boundary point used for signal characterization in H-E1). Unlike Coste data, the gap is initially negative at low KL (gold preference rises faster than RM), crosses zero at $\sim $3.5 nats, then enters the positive regime. This non-monotone shape accounts for the lower $R^2 = 0.701$ in the Gao linear regression, which uses $n=10$ observations (the KL$=0$ boundary point excluded; see Section~\ref {subsec:replication})}{figure.8}{}}
