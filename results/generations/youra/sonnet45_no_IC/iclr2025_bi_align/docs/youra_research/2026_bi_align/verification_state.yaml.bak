# Hypothesis verification state for Phase 2C-4 execution loop.
# Generated by Phase 2B Planning workflow in UNATTENDED mode.
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

metadata:
  generated_at: "2026-07-12"
  workflow: "phase2b-planning"
  main_hypothesis_id: "H-BD1-v1"
  total_hypotheses: 4
  execution_mode: "UNATTENDED"
  architecture: "linear_dependency_chain"

# Main Hypothesis Context
main_hypothesis:
  id: "H-BD1-v1"
  title: "Bidirectional Alignment via Joint DPO + Attribute Training"
  confidence: 0.80
  core_statement: |
    Joint optimization of DPO and attribute-conditioned generation achieves bidirectional alignment with
    (1) AI-to-Human via preference win rate ≥95% of DPO baseline,
    (2) Human-to-AI via attribute steering accuracy ≥80%,
    (3) Emergent disentanglement (ρ ≤0.3) outperforming sequential training by ≥5% on both dimensions.
  alternative_h0: |
    Joint training performs NO BETTER than sequential (DPO → Attr) on at least ONE dimension,
    with difference ≤5% on preference OR steering OR disentanglement.

# Sub-Hypotheses Schema (for /hypothesis-next command)
sub_hypotheses:
  H-E1:
    type: "EXISTENCE"
    title: "Joint Training Existence & Convergence"
    status: "PENDING"
    prerequisites: []
    gate_type: "MUST_WORK"
    phase2c_ready: true
  H-M1:
    type: "MECHANISM"
    title: "Shared Representation Learning"
    status: "PENDING"
    prerequisites: ["H-E1"]
    gate_type: "SHOULD_WORK"
    phase2c_ready: true
  H-M2:
    type: "MECHANISM"
    title: "Disentanglement Validation"
    status: "PENDING"
    prerequisites: ["H-M1"]
    gate_type: "SHOULD_WORK"
    phase2c_ready: true
  H-M3:
    type: "MECHANISM"
    title: "Emergent Benefit (Joint > Sequential)"
    status: "PENDING"
    prerequisites: ["H-M2"]
    gate_type: "DETERMINES_SUCCESS"
    phase2c_ready: true

# Sub-Hypotheses Inventory (Detailed)
hypotheses:
  - id: "H-E1"
    type: "EXISTENCE"
    title: "Joint Training Existence & Convergence"
    status: "PENDING"
    prerequisites: []
    gate:
      type: "MUST_WORK"
      pass_condition: "Training converges, Win rate ≥50%, Steering ≥60%"
      fail_action: "STOP: Joint training not feasible, reconsider approach"
    success_criteria:
      - "Both L_DPO and L_attr decrease monotonically without divergence"
      - "Preference win rate ≥50% (better than random)"
      - "Attribute steering accuracy ≥60% (better than chance)"
      - "Gradient angles <120° (no catastrophic interference)"
    phase2c_ready: true
    phase3_ready: false
    phase4_ready: false

  - id: "H-M1"
    type: "MECHANISM"
    title: "Shared Representation Learning"
    status: "PENDING"
    prerequisites: ["H-E1"]
    gate:
      type: "SHOULD_WORK"
      pass_condition: "Probing ≥70%, CKA ≤0.7"
      fail_action: "Investigate architecture or loss weighting"
    success_criteria:
      - "Probing accuracy ≥70% for preferences AND R²≥0.6 for attributes"
      - "CKA similarity ≤0.7 between Joint and DPO-only representations"
      - "Gradient cosine similarity in range [-0.5, 0.5]"
    phase2c_ready: true
    phase3_ready: false
    phase4_ready: false

  - id: "H-M2"
    type: "MECHANISM"
    title: "Disentanglement Validation"
    status: "PENDING"
    prerequisites: ["H-M1"]
    gate:
      type: "SHOULD_WORK"
      pass_condition: "ρ ≤ 0.3, Δr_DPO < 0.1"
      fail_action: "Check attribute orthogonality, adjust α"
    success_criteria:
      - "Pearson correlation |ρ(r_DPO, A_pred)| ≤ 0.3 for all attributes"
      - "Quality score variance Δr_DPO < 0.1 when attributes varied"
      - "Factor analysis shows ≥2 distinct factors (eigenvalues >1)"
    phase2c_ready: true
    phase3_ready: false
    phase4_ready: false

  - id: "H-M3"
    type: "MECHANISM"
    title: "Emergent Benefit (Joint > Sequential)"
    status: "PENDING"
    prerequisites: ["H-M2"]
    gate:
      type: "DETERMINES_SUCCESS"
      pass_condition: "Δ_pref ≥5% AND Δ_attr ≥5%"
      fail_action: "Pivot to efficiency claim vs novelty claim"
    success_criteria:
      - "Joint ≥ Sequential + 5% on preference win rate"
      - "Joint ≥ Sequential + 5% on steering accuracy"
      - "BOTH conditions must hold simultaneously"
    phase2c_ready: true
    phase3_ready: false
    phase4_ready: false

# Dependency Graph (DAG)
dependencies:
  structure: "linear_chain"
  critical_path: ["H-E1", "H-M1", "H-M2", "H-M3"]
  edges:
    - from: "H-E1"
      to: "H-M1"
      condition: "PASS"
    - from: "H-M1"
      to: "H-M2"
      condition: "PASS"
    - from: "H-M2"
      to: "H-M3"
      condition: "PASS"

# Gate Configuration
gates:
  MUST_WORK:
    hypotheses: ["H-E1"]
    on_fail: "STOP_WORKFLOW"
    description: "Foundational feasibility - if fails, entire approach invalid"
  SHOULD_WORK:
    hypotheses: ["H-M1", "H-M2"]
    on_fail: "INVESTIGATE_AND_ADJUST"
    description: "Mechanism validation - if fails, adjust parameters or architecture"
  DETERMINES_SUCCESS:
    hypotheses: ["H-M3"]
    on_fail: "PIVOT_CLAIM"
    description: "Core novelty test - if fails, reframe contribution"

# Execution Timeline
timeline:
  total_duration_days: "11-17"
  total_gpu_hours: 380
  phases:
    - phase: "Phase 1: Existence"
      days: "1-5"
      hypotheses: ["H-E1"]
      gpu_hours: 150
    - phase: "Phase 2: Representation"
      days: "6-10"
      hypotheses: ["H-M1"]
      gpu_hours: 50
    - phase: "Phase 3: Disentanglement"
      days: "11-15"
      hypotheses: ["H-M2"]
      gpu_hours: 30
    - phase: "Phase 4: Emergent Benefit"
      days: "16-23"
      hypotheses: ["H-M3"]
      gpu_hours: 150

# Risk Summary
risks:
  - id: "R1"
    title: "Dataset Inaccessibility"
    probability: "LOW"
    impact: "HIGH"
    mapped_hypotheses: ["H-E1", "H-M1", "H-M2", "H-M3"]
    mitigation: "Pre-execution verification + fallback to Alpaca/Dolly"
  - id: "R2"
    title: "Objective Incompatibility"
    probability: "MEDIUM"
    impact: "CRITICAL"
    mapped_hypotheses: ["H-E1"]
    mitigation: "Gradient monitoring + adaptive weighting"
  - id: "R3"
    title: "Attribute-Preference Conflation"
    probability: "MEDIUM"
    impact: "HIGH"
    mapped_hypotheses: ["H-M2", "H-M3"]
    mitigation: "Pre-training ρ test + attribute selection"
  - id: "R4"
    title: "No Emergent Benefit"
    probability: "MEDIUM-HIGH"
    impact: "CRITICAL"
    mapped_hypotheses: ["H-M3"]
    mitigation: "Rigorous sequential baseline + hyperparameter tuning"
  - id: "R5"
    title: "Evaluation Metric Confounds"
    probability: "LOW-MEDIUM"
    impact: "MEDIUM"
    mapped_hypotheses: ["H-E1", "H-M2", "H-M3"]
    mitigation: "Multi-metric validation + human cross-check"

# Experimental Setup (Shared Across Hypotheses)
experimental_setup:
  dataset:
    primary: "Anthropic HH-RLHF"
    size: "161k preference pairs"
    split: "80/20 train/test"
    source: "HuggingFace: Anthropic/hh-rlhf"
    verified_accessible: true
  model:
    architecture: "GPT-2 1.5B or Pythia 2.8B"
    source: "HuggingFace pre-trained checkpoints"
    reference_policy: "πref from SFT on high-quality demonstrations"
  baselines:
    - name: "DPO Standalone"
      performance: "57.5% win rate vs SFT (GPT-4 judge)"
      dataset: "HH-RLHF"
    - name: "SteerLM Standalone"
      performance: "87% steering accuracy, <5% latency"
      dataset: "OpenAssistant, Anthropic HH"
    - name: "Sequential (DPO → Attr)"
      performance: "To be established"
      note: "Critical baseline for H-M3 emergent benefit test"

# Variables (Shared IV/DV/CV)
variables:
  independent:
    - name: "Training Objective"
      levels: ["Joint (DPO+Attr)", "DPO-only", "Attr-only", "Sequential"]
    - name: "Loss Weight Alpha"
      range: [0.5, 0.9]
      default: 0.7
  dependent:
    - name: "Preference Win Rate"
      measurement: "% preferred over DPO baseline (GPT-4 judge)"
      threshold: "≥0.95 × DPO_baseline"
    - name: "Attribute Steering Accuracy"
      measurement: "% within ±0.5 on 1-5 scale"
      threshold: "≥0.80"
    - name: "Disentanglement Correlation ρ"
      measurement: "Pearson correlation between r_DPO and A_pred"
      threshold: "≤0.3"
  controlled:
    - "Model Architecture (GPT-2 1.5B)"
    - "Training Hyperparameters (lr=1e-5, batch=128, β=0.1)"
    - "Evaluation Protocol (same test splits, same judges)"

# Established Facts (BUILD_ON - Do NOT re-test)
established_facts:
  - "DPO achieves comparable/better quality than PPO-RLHF (Rafailov et al. 2023)"
  - "SteerLM achieves 87% steering accuracy (Dong et al. 2023)"
  - "HH-RLHF, OpenAssistant are accessible datasets (verified)"
  - "Multi-task weighted sum is mathematically valid (standard ML)"

# Phase 2C Integration
phase2c_config:
  ready_for_experiment_design: true
  hypotheses_to_design: ["H-E1", "H-M1", "H-M2", "H-M3"]
  design_level: "1.5"  # Concrete + Pseudo-code
  mcp_requirements:
    archon: true  # Code examples, past implementations
    serena: true  # Codebase analysis, symbol search
    exa: false    # Not needed for established ML methods

# Workflow Status
workflow_status:
  phase2a_dialogue: "COMPLETE"
  phase2b_planning: "COMPLETE"
  phase2c_experiment_design: "READY"
  phase3_implementation_planning: "PENDING"
  phase4_coding: "PENDING"
  phase5_baseline_comparison: "SKIPPED"  # skip_baseline_comparison: true
  phase6_paper_writing: "PENDING"
