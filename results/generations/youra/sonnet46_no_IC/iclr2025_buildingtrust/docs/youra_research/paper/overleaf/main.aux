\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Side-by-side comparison of raw Spearman (left) and partial Spearman (right) $6 \times 6$ correlation heatmaps. Controlling for model scale and RLHF status reveals the underlying trustworthiness geometry.}}{8}{figure.1}\protected@file@percent }
\newlabel{fig:heatmaps}{{1}{8}{Side-by-side comparison of raw Spearman (left) and partial Spearman (right) $6 \times 6$ correlation heatmaps. Controlling for model scale and RLHF status reveals the underlying trustworthiness geometry}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Absolute partial Spearman correlation $|\rho _\text  {partial}|$ for all 15 dimension pairs, sorted by magnitude. Red bars indicate Bonferroni-significant pairs ($p < 0.0033$). 8 of 15 pairs exceed the significance threshold.}}{8}{figure.2}\protected@file@percent }
\newlabel{fig:bar}{{2}{8}{Absolute partial Spearman correlation $|\rho _\text {partial}|$ for all 15 dimension pairs, sorted by magnitude. Red bars indicate Bonferroni-significant pairs ($p < 0.0033$). 8 of 15 pairs exceed the significance threshold}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Average-linkage hierarchical clustering dendrogram of the $6 \times 6$ partial Spearman distance matrix. The dashed line marks the 2-cluster cut: robustness branches early, confirming its isolation from the 5-dimension RLHF-shaped cluster.}}{8}{figure.3}\protected@file@percent }
\newlabel{fig:dendrogram}{{3}{8}{Average-linkage hierarchical clustering dendrogram of the $6 \times 6$ partial Spearman distance matrix. The dashed line marks the 2-cluster cut: robustness branches early, confirming its isolation from the 5-dimension RLHF-shaped cluster}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces OLS residualization demonstration for the safety--privacy pair ($\rho = 0.971$). Points colored by RLHF status show confound removal isolates the trustworthiness-specific correlation.}}{8}{figure.4}\protected@file@percent }
\newlabel{fig:scatter}{{4}{8}{OLS residualization demonstration for the safety--privacy pair ($\rho = 0.971$). Points colored by RLHF status show confound removal isolates the trustworthiness-specific correlation}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Minimum spanning tree (MST) of the partial Spearman distance matrix. Hub nodes \{truthfulness, fairness, privacy\} form the 3-dimension minimum evaluation set. Leaf nodes (safety, robustness, machine\_ethics) are redundant for evaluation compression.}}{8}{figure.5}\protected@file@percent }
\newlabel{fig:mst}{{5}{8}{Minimum spanning tree (MST) of the partial Spearman distance matrix. Hub nodes \{truthfulness, fairness, privacy\} form the 3-dimension minimum evaluation set. Leaf nodes (safety, robustness, machine\_ethics) are redundant for evaluation compression}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Per-edge bootstrap frequency heatmap (1000 resamples of 14/16 models). Four of five MST edges exceed 94\% stability. The machine\_ethics--privacy edge at 68.8\% reflects near-tie geometry at $n=16$.}}{9}{figure.6}\protected@file@percent }
\newlabel{fig:bootstrap}{{6}{9}{Per-edge bootstrap frequency heatmap (1000 resamples of 14/16 models). Four of five MST edges exceed 94\% stability. The machine\_ethics--privacy edge at 68.8\% reflects near-tie geometry at $n=16$}{figure.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces RLHF-induced score changes ($\Delta = \text  {Chat} - \text  {Base}$) for safety and machine\_ethics across LLaMA-2 7B, 13B, and 70B. All six bars are positive, demonstrating joint optimization at every scale.}}{9}{figure.7}\protected@file@percent }
\newlabel{fig:deltas}{{7}{9}{RLHF-induced score changes ($\Delta = \text {Chat} - \text {Base}$) for safety and machine\_ethics across LLaMA-2 7B, 13B, and 70B. All six bars are positive, demonstrating joint optimization at every scale}{figure.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces 2D delta space scatter ($\Delta _\text  {safety}$ vs.\ $\Delta _\text  {ethics}$) for LLaMA-2 within-family pairs. All three scale points land in the upper-right quadrant (both positive), confirming joint RLHF optimization.}}{9}{figure.8}\protected@file@percent }
\newlabel{fig:delta2d}{{8}{9}{2D delta space scatter ($\Delta _\text {safety}$ vs.\ $\Delta _\text {ethics}$) for LLaMA-2 within-family pairs. All three scale points land in the upper-right quadrant (both positive), confirming joint RLHF optimization}{figure.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Full $6 \times 6$ partial Spearman correlation heatmap with the safety--robustness cell highlighted. The directional negative value ($\rho = -0.188$) is consistent with a safety-robustness tension but does not reach Bonferroni significance at $n=16$.}}{9}{figure.9}\protected@file@percent }
\newlabel{fig:rho_highlight}{{9}{9}{Full $6 \times 6$ partial Spearman correlation heatmap with the safety--robustness cell highlighted. The directional negative value ($\rho = -0.188$) is consistent with a safety-robustness tension but does not reach Bonferroni significance at $n=16$}{figure.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Ward-linkage dendrogram confirming the 2-cluster structure (silhouette = 0.637). The functional split is \{robustness\} vs.\ \{all other 5 dimensions\}.}}{9}{figure.10}\protected@file@percent }
\newlabel{fig:dendrogram_ward}{{10}{9}{Ward-linkage dendrogram confirming the 2-cluster structure (silhouette = 0.637). The functional split is \{robustness\} vs.\ \{all other 5 dimensions\}}{figure.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces 2D multidimensional scaling (MDS) projection of the $6 \times 6$ partial Spearman distance matrix. Robustness is geometrically separated from the tight 5-dimension cluster.}}{9}{figure.11}\protected@file@percent }
\newlabel{fig:mds}{{11}{9}{2D multidimensional scaling (MDS) projection of the $6 \times 6$ partial Spearman distance matrix. Robustness is geometrically separated from the tight 5-dimension cluster}{figure.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Silhouette scores for $k=2$ clustering using Ward, average, and complete linkage methods (all = 0.637) vs.\ $k=3$ (0.500). Identical scores across linkage methods confirm the 2-cluster structure is not a methodological artifact.}}{10}{figure.12}\protected@file@percent }
\newlabel{fig:silhouette}{{12}{10}{Silhouette scores for $k=2$ clustering using Ward, average, and complete linkage methods (all = 0.637) vs.\ $k=3$ (0.500). Identical scores across linkage methods confirm the 2-cluster structure is not a methodological artifact}{figure.12}{}}
