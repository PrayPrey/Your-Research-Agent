% Minimal ICML 2025 style file (compatible subset)
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{icml2025}[2025/01/01 ICML 2025 submission style]

% Page geometry
\RequirePackage[letterpaper,margin=1in]{geometry}

% Fonts and typography
\RequirePackage{times}
\RequirePackage[T1]{fontenc}

% Math packages
\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{amsthm}

% Graphics and tables
\RequirePackage{graphicx}
\RequirePackage{booktabs}
\RequirePackage{xcolor}

% Hyperlinks
\RequirePackage[colorlinks=true,linkcolor=blue,citecolor=blue,urlcolor=blue]{hyperref}

% Algorithms
\RequirePackage{algorithm}
\RequirePackage{algorithmic}

% Title formatting
\renewcommand{\maketitle}{%
  \begin{center}
    {\LARGE\bfseries\@title\par}
    \vskip 1em
    {\large\@author\par}
    \vskip 0.5em
    {\large\@date\par}
  \end{center}
  \vskip 2em
}

% Section formatting
\RequirePackage{titlesec}
\titleformat{\section}{\Large\bfseries}{\thesection}{1em}{}
\titleformat{\subsection}{\large\bfseries}{\thesubsection}{1em}{}
\titleformat{\subsubsection}{\normalsize\bfseries}{\thesubsubsection}{1em}{}

% Abstract environment
\renewenvironment{abstract}%
  {\small\quotation\noindent\textbf{Abstract}\quad}%
  {\endquotation}

% Theorem environments
\newtheorem{theorem}{Theorem}
\newtheorem{lemma}{Lemma}
\newtheorem{proposition}{Proposition}
\newtheorem{corollary}{Corollary}
\newtheorem{definition}{Definition}
\newtheorem{remark}{Remark}

\endinput
