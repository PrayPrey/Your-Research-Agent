% ICML 2025 Style File (Simplified - Full version from ICML website recommended)
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{icml2025}[2025/01/01 ICML 2025 Submission Template]

% Page layout
\RequirePackage[letterpaper,margin=1in]{geometry}
\RequirePackage{fancyhdr}

% Title formatting
\newcommand{\icmltitlerunning}[1]{\gdef\@icmltitlerunning{#1}}
\newcommand{\icmltitle}[1]{\title{#1}\gdef\@icmltitle{#1}}
\newcommand{\icmlsetsymbol}[2]{\expandafter\gdef\csname icmlsymbol#1\endcsname{#2}}
\newenvironment{icmlauthorlist}{}{}
\newcommand{\icmlauthor}[2]{\author{#1}}
\newcommand{\icmlaffiliation}[2]{}
\newcommand{\icmlcorrespondingauthor}[2]{}
\newcommand{\icmlkeywords}[1]{\gdef\@icmlkeywords{#1}}

% Header/footer
\pagestyle{fancy}
\fancyhf{}
\fancyhead[C]{\small\textit{Submitted to ICML 2025. Do not distribute.}}
\fancyfoot[C]{\thepage}
\renewcommand{\headrulewidth}{0pt}

\endinput
