\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Per-language retention rates across all five threshold levels. The consistent ordering \textit  {es} $>$ \textit  {fr} $>$ \textit  {it} $>$ \textit  {en} $>$ \textit  {de} maps onto the Romance--Germanic language family divide, with Spanish reaching 100\% retention at $k$=40 while German retains only 20.7\%.}}{7}{figure.2}\protected@file@percent }
\newlabel{fig:retention_heatmap}{{2}{7}{Per-language retention rates across all five threshold levels. The consistent ordering \textit {es} $>$ \textit {fr} $>$ \textit {it} $>$ \textit {en} $>$ \textit {de} maps onto the Romance--Germanic language family divide, with Spanish reaching 100\% retention at $k$=40 while German retains only 20.7\%}{figure.2}{}}
