%% Generated: 2026-08-28 by YOURA Pipeline Phase 6.5.1

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{icml2025}[2025/01/01 ICML 2025 Minimal Stub]

%% Basic document setup (two-column)
\RequirePackage{geometry}
\geometry{letterpaper, margin=1in, columnsep=0.2in}

%% Title formatting
\newcommand{\icmltitle}[1]{\title{#1}}
\newcommand{\icmltitlerunning}[1]{\def\@shorttitle{#1}}

%% Author macros (simplified)
\newenvironment{icmlauthorlist}{}{}
\newcommand{\icmlauthor}[2]{#1\textsuperscript{#2}}
\newcommand{\icmlaffiliation}[2]{\def\@affil{#2}}
\newcommand{\icmlcorrespondingauthor}[2]{\def\@contact{#1 (#2)}}
\newcommand{\icmlsetsymbol}[2]{}
\newcommand{\icmlkeywords}[1]{\def\@keywords{#1}}

%% Print affiliations
\newcommand{\printAffiliationsAndNotice}[1]{%
  \maketitle
  \begin{center}
  \textit{Keywords:} \@keywords
  \end{center}
}

%% Citation package compatibility
\RequirePackage{natbib}
\setcitestyle{authoryear,round,comma,aysep={},yysep={,},notesep={, }}

%% Formatting tweaks
\setlength{\parskip}{0pt}
\setlength{\parsep}{0pt}
\setlength{\headsep}{0.2in}
\setlength{\topskip}{0pt}
\setlength{\topmargin}{0pt}
\setlength{\topsep}{0pt}
\setlength{\partopsep}{0pt}

\endinput
