% ICML 2025 style file (minimal functional version for compilation)
% Based on ICML 2024 format - https://icml.cc/Conferences/2025/StyleAuthorInstructions

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{icml2025}[2025/01/15 ICML 2025 submission/camera-ready style]

% Required packages
\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{graphicx}
\RequirePackage{natbib}
\RequirePackage{algorithm}
\RequirePackage{algorithmic}
\RequirePackage{hyperref}
\RequirePackage{booktabs}
\RequirePackage{times}

% Page layout
\setlength{\textheight}{9.0in}
\setlength{\textwidth}{5.5in}
\setlength{\oddsidemargin}{0.25in}
\setlength{\evensidemargin}{0.25in}
\setlength{\topmargin}{-0.25in}

% Title formatting
\def\@maketitle{%
  \newpage
  \null
  \vskip 2em%
  \begin{center}%
  \let \footnote \thanks
    {\LARGE \@title \par}%
    \vskip 1.5em%
    {\large
      \lineskip .5em%
      \begin{tabular}[t]{c}%
        \@author
      \end{tabular}\par}%
    \vskip 1em%
    {\large \@date}%
  \end{center}%
  \par
  \vskip 1.5em}

% Section formatting
\renewcommand\section{\@startsection{section}{1}{\z@}%
  {-3.5ex \@plus -1ex \@minus -.2ex}%
  {2.3ex \@plus.2ex}%
  {\normalfont\Large\bfseries}}

\renewcommand\subsection{\@startsection{subsection}{2}{\z@}%
  {-3.25ex\@plus -1ex \@minus -.2ex}%
  {1.5ex \@plus .2ex}%
  {\normalfont\large\bfseries}}

% Abstract environment
\renewenvironment{abstract}{%
  \small
  \begin{center}%
    {\bfseries \abstractname\vspace{-.5em}\vspace{\z@}}%
  \end{center}%
  \quotation
}{\endquotation}

% Bibliography style
\bibliographystyle{plainnat}
\bibpunct{(}{)}{;}{a}{,}{,}

\endinput
