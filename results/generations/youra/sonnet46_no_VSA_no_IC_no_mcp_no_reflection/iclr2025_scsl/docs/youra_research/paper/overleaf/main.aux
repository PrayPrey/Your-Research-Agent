\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces ROC curves at epoch~50 (best alignment epoch on Waterbirds). Alignment ROC curve lies near the diagonal (AUC = 0.349); loss ROC curve shows substantial area above diagonal (AUC = 0.775).}}{8}{figure.6}\protected@file@percent }
\newlabel{fig:roc_wb}{{6}{8}{ROC curves at epoch~50 (best alignment epoch on Waterbirds). Alignment ROC curve lies near the diagonal (AUC = 0.349); loss ROC curve shows substantial area above diagonal (AUC = 0.775)}{figure.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces ROC curves at epoch~50 (best alignment epoch on CelebA). Alignment shows slightly positive AUC (0.632) but well below loss (0.905).}}{8}{figure.7}\protected@file@percent }
