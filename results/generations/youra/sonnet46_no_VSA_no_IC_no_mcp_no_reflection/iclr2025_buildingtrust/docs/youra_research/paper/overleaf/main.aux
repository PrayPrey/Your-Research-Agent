\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Permutation test results (n=1000 shuffles). Observed LOO-CV accuracy of 83.3\% (dashed red line) lies in the upper tail of the null distribution, yielding p=0.031 (one-tailed).}}{7}{figure.3}\protected@file@percent }
\newlabel{fig:permutation}{{3}{7}{Permutation test results (n=1000 shuffles). Observed LOO-CV accuracy of 83.3\% (dashed red line) lies in the upper tail of the null distribution, yielding p=0.031 (one-tailed)}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Signed per-pair deltas (DPO score minus SFT score) for BBQ (left) and WinoGender (right) across all 6 model pairs. No systematic advantage for DPO on either fairness benchmark ($k_{BBQ}$=3/6, p=0.66; $k_{WG}$=4/6, p=0.34).}}{7}{figure.4}\protected@file@percent }
\newlabel{fig:bbq_winogender}{{4}{7}{Signed per-pair deltas (DPO score minus SFT score) for BBQ (left) and WinoGender (right) across all 6 model pairs. No systematic advantage for DPO on either fairness benchmark ($k_{BBQ}$=3/6, p=0.66; $k_{WG}$=4/6, p=0.34)}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Scatter plot of BBQ scores for each model pair (DPO score vs SFT score). Points near the diagonal indicate no systematic advantage. Three of six pairs fall above (DPO$>$SFT); three fall below.}}{7}{figure.5}\protected@file@percent }
\newlabel{fig:bbq_scatter}{{5}{7}{Scatter plot of BBQ scores for each model pair (DPO score vs SFT score). Points near the diagonal indicate no systematic advantage. Three of six pairs fall above (DPO$>$SFT); three fall below}{figure.5}{}}
