\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Variance selection comparison: top-50 variance-guided vs.\ random-50.}}{5}{table.4}\protected@file@percent }
\newlabel{tab:selection}{{4}{5}{Variance selection comparison: top-50 variance-guided vs.\ random-50}{table.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Binary execution reward variance distribution across 374 MBPP problems. 343 problems have $v_i=0$ (all-fail or all-pass); 29 have $v_i=0.1875$ (the maximum achievable under $k=4$ discrete sampling). No intermediate variance levels exist under these generation constraints.}}{5}{figure.2}\protected@file@percent }
\newlabel{fig:variance_hist}{{2}{5}{Binary execution reward variance distribution across 374 MBPP problems. 343 problems have $v_i=0$ (all-fail or all-pass); 29 have $v_i=0.1875$ (the maximum achievable under $k=4$ discrete sampling). No intermediate variance levels exist under these generation constraints}{figure.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.3}RQ3: Gradient Concentration During Training (h-m2, h-m3) --- FAILED}{5}{subsection.5.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Mean variance comparison between variance-guided top-50 selection and random-50 selection, with individual data points overlaid. Variance-guided selection achieves $4.24\times $ higher mean variance (Mann-Whitney $p=2.22\times 10^{-6}$), confirming a statistically robust selection signal.}}{6}{figure.3}\protected@file@percent }
\newlabel{fig:mean_comparison}{{3}{6}{Mean variance comparison between variance-guided top-50 selection and random-50 selection, with individual data points overlaid. Variance-guided selection achieves $4.24\times $ higher mean variance (Mann-Whitney $p=2.22\times 10^{-6}$), confirming a statistically robust selection signal}{figure.3}{}}
