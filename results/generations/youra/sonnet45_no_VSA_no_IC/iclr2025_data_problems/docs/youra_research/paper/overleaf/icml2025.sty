% ICML 2025 style file (minimal compatibility shim)
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{icml2025}[2025/01/01 ICML 2025 submission template]

% Load required packages
\RequirePackage{times}
\RequirePackage{natbib}
\RequirePackage{algorithm}
\RequirePackage{algorithmic}
\RequirePackage{hyperref}
\RequirePackage{url}
\RequirePackage{booktabs}
\RequirePackage{amsfonts}
\RequirePackage{amsmath}
\RequirePackage{graphicx}
\RequirePackage{microtype}

% Page layout
\setlength{\textheight}{9.0in}
\setlength{\textwidth}{5.5in}
\setlength{\oddsidemargin}{0.25in}
\setlength{\evensidemargin}{0.25in}
\setlength{\topmargin}{-0.5in}

% Title formatting
\def\icmltitle#1{\gdef\@icmltitle{#1}}
\def\icmlauthor#1{\gdef\@icmlauthor{#1}}
\def\icmlaffiliation#1{\gdef\@icmlaffiliation{#1}}

\renewcommand{\maketitle}{%
  \begin{center}%
    {\LARGE \@icmltitle \par}%
    \vskip 0.5em%
    {\large \@icmlauthor \par}%
    \vskip 0.3em%
    {\normalsize \@icmlaffiliation \par}%
  \end{center}%
  \vskip 1em%
}

% Section formatting
\renewcommand{\section}{\@startsection{section}{1}{\z@}%
  {-3.5ex \@plus -1ex \@minus -.2ex}%
  {2.3ex \@plus.2ex}%
  {\normalfont\Large\bfseries}}

\renewcommand{\subsection}{\@startsection{subsection}{2}{\z@}%
  {-2.5ex \@plus -1ex \@minus -.2ex}%
  {1.5ex \@plus.2ex}%
  {\normalfont\large\bfseries}}

% Customize citation style
\bibpunct{(}{)}{;}{a}{,}{,}

\endinput
