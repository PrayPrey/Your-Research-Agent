\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Coefficient trajectories across dataset scales. Quality coefficient $\alpha _Q$ (blue) decreases while diversity coefficient $\alpha _D$ (orange) increases, crossing at $\sim $300K tokens. Error bars show standard deviation across 3 random seeds.}}{16}{figure.1}\protected@file@percent }
\newlabel{fig:coefficient_trajectories}{{1}{16}{Coefficient trajectories across dataset scales. Quality coefficient $\alpha _Q$ (blue) decreases while diversity coefficient $\alpha _D$ (orange) increases, crossing at $\sim $300K tokens. Error bars show standard deviation across 3 random seeds}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Ordering effects across scales. Quality-first (QD, blue) universally outperforms diversity-first (DQ, orange) from 10K to 10M tokens. Peak effect occurs at 1M tokens (Cohen's $d=2.48$). Bars show mean performance; error bars are standard deviation.}}{17}{figure.2}\protected@file@percent }
\newlabel{fig:ordering_effects}{{2}{17}{Ordering effects across scales. Quality-first (QD, blue) universally outperforms diversity-first (DQ, orange) from 10K to 10M tokens. Peak effect occurs at 1M tokens (Cohen's $d=2.48$). Bars show mean performance; error bars are standard deviation}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Interaction plot showing non-additive compositional effects. QD (quality$\rightarrow $diversity) and DQ (diversity$\rightarrow $quality) trajectories diverge at medium scales, with maximum separation at 1M tokens, confirming sequential ordering matters beyond domain proportion mixing.}}{18}{figure.3}\protected@file@percent }
\newlabel{fig:interaction_plot}{{3}{18}{Interaction plot showing non-additive compositional effects. QD (quality$\rightarrow $diversity) and DQ (diversity$\rightarrow $quality) trajectories diverge at medium scales, with maximum separation at 1M tokens, confirming sequential ordering matters beyond domain proportion mixing}{figure.3}{}}
