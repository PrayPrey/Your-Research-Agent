% Minimal ICML 2025 Style (Fallback)
% Based on standard article class with two-column layout
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{icml2025}[2025/01/01 ICML 2025 Fallback Style]

% Page layout
\RequirePackage[letterpaper,margin=1in]{geometry}
\RequirePackage{fancyhdr}

% Math and symbols
\RequirePackage{amsmath,amssymb,amsfonts}
\RequirePackage{algorithmic}

% Graphics
\RequirePackage{graphicx}
\RequirePackage{booktabs}

% Hyperlinks
\RequirePackage{hyperref}
\hypersetup{colorlinks=true,linkcolor=blue,citecolor=blue,urlcolor=blue}

% Title macros
\newcommand{\icmltitlerunning}[1]{\def\@shorttitle{#1}}
\newcommand{\icmltitle}[1]{\title{#1}}
\newenvironment{icmlauthorlist}{}{}
\newcommand{\icmlauthor}[2]{\author{#1}}
\newcommand{\icmlaffiliation}[2]{\thanks{#1: #2}}
\newcommand{\icmlcorrespondingauthor}[2]{\thanks{Corresponding author: #1, #2}}
\newcommand{\icmlkeywords}[1]{\def\@keywords{#1}}
\newcommand{\icmlsetsymbol}[2]{}

\endinput
